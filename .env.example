# Optional. Without OPENROUTER_API_KEY the product uses its deterministic local intent parser.
OPENROUTER_API_KEY=

# Optional override. Defaults to google/gemma-4-31b-it:free.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional shared-room backend. Without these, the app keeps the local single-device demo flow.
# Use the public project URL and publishable/anon key only. Never expose a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional real catalogue + country-aware streaming availability.
# Server-side TMDB API Read Access Token. Never prefix this with VITE_.
TMDB_ACCESS_TOKEN=
